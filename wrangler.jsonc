{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lanpartyvc-signal",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": ""
  }
}
